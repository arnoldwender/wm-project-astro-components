---
/**
 * SEO Component - WenderMedia Astro Components
 *
 * Drop-in <head> component that renders a complete set of SEO meta tags,
 * Open Graph tags, Twitter Card tags, hreflang links, Apple/Microsoft
 * platform tags, optional JSON-LD structured data, and security headers.
 * Place it once inside your BaseLayout <head> and pass page-level props.
 *
 * Features:
 * - Primary meta: title (auto-appends siteName), description, robots, language, author, theme-color
 * - Open Graph: type, url, title, description, image (1200x630), locale, site_name
 * - Twitter Cards: summary_large_image, creator, site handle
 * - Hreflang: generates <link rel="alternate"> for each locale plus x-default
 * - Canonical URL support with automatic fallback to current page URL
 * - noindex / nofollow toggles for staging or thin-content pages
 * - Structured data: pass any JSON-LD object via the structuredData prop
 * - Referrer policy via <meta name="referrer">; las demas cabeceras de seguridad
 *   NO se pueden fijar desde el HTML y van en la config del host (netlify.toml,
 *   public/_headers, .htaccess)
 * - Apple Mobile Web App and Microsoft tile color support
 * - Locale mapping for en, de, es, fr (extensible)
 *
 * @example
 * ---
 * import SEO from '@components/seo/SEO.astro';
 * ---
 * <head>
 *   <SEO
 *     title="Web Design Services"
 *     description="Professional web design for small businesses in Halle (Saale)."
 *     canonical="https://example.com/services/web-design"
 *     image="/images/og-webdesign.jpg"
 *     imageAlt="Acme Corp web design showcase"
 *     siteName="Acme Corp"
 *     lang="de"
 *     twitterHandle="acmecorp"
 *   />
 * </head>
 *
 * @example
 * <!-- Multilingual page with structured data and noindex -->
 * <SEO
 *   title="Draft Article"
 *   description="This page is still in progress."
 *   noindex={true}
 *   lang="en"
 *   hreflang={[
 *     { lang: 'en', url: 'https://example.com/en/draft' },
 *     { lang: 'de', url: 'https://example.com/de/entwurf' },
 *   ]}
 *   structuredData={{
 *     '@context': 'https://schema.org',
 *     '@type': 'WebPage',
 *     name: 'Draft Article',
 *   }}
 * />
 *
 * @copyright 2007-2026 Arnold Wender · Wender Media. All Rights Reserved. License: LicenseRef-Wender-Media-Source-1.0
 * @see https://github.com/arnoldwender/wm-project-astro-components
 */

export interface HreflangLink {
  lang: string;
  url: string;
}

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  lang?: string;
  hreflang?: HreflangLink[];
  siteName?: string;
  twitterHandle?: string;
  structuredData?: object;
  noindex?: boolean;
  nofollow?: boolean;
  themeColor?: string;
}

const {
  title,
  description,
  canonical,
  image = '/og-image.jpg',
  imageAlt = '',
  type = 'website',
  lang = 'en',
  hreflang = [],
  siteName = 'Website',
  twitterHandle,
  structuredData,
  noindex = false,
  nofollow = false,
  themeColor = '#000000',
} = Astro.props;

const fullTitle = title.includes('|') ? title : `${title} | ${siteName}`;
const currentUrl = canonical || Astro.url.href;
const robotsContent = `${noindex ? 'noindex' : 'index'}, ${nofollow ? 'nofollow' : 'follow'}`;

const localeMap: Record<string, string> = {
  en: 'en_US',
  de: 'de_DE',
  es: 'es_ES',
  fr: 'fr_FR',
};
---

<!-- Primary Meta Tags -->
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
<meta name="robots" content={robotsContent} />
<meta name="language" content={lang} />
<meta name="author" content={siteName} />
<meta name="publisher" content={siteName} />
<meta name="copyright" content={`© ${new Date().getFullYear()} ${siteName}`} />
<meta name="theme-color" content={themeColor} />

<!-- Canonical URL -->
{canonical && <link rel="canonical" href={canonical} />}

<!-- Hreflang Links -->
{hreflang.map(({ lang, url }) => (
  <link rel="alternate" hreflang={lang} href={url} />
))}
{hreflang.length > 0 && (
  <link rel="alternate" hreflang="x-default" href={hreflang.find(h => h.lang === 'en')?.url || canonical} />
)}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={currentUrl} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />
<meta property="og:image:alt" content={imageAlt || description} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:locale" content={localeMap[lang] || 'en_US'} />
<meta property="og:site_name" content={siteName} />
<meta property="og:updated_time" content={new Date().toISOString()} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={currentUrl} />
<meta property="twitter:title" content={fullTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={image} />
<meta property="twitter:image:alt" content={imageAlt || description} />
{twitterHandle && (
  <>
    <meta name="twitter:creator" content={`@${twitterHandle}`} />
    <meta name="twitter:site" content={`@${twitterHandle}`} />
  </>
)}

<!-- LinkedIn / Article -->
<meta property="og:image:secure_url" content={image} />
<meta property="article:author" content={siteName} />
<meta property="article:publisher" content={siteName} />

<!-- Apple -->
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="default" />
<meta name="apple-mobile-web-app-title" content={siteName} />

<!-- Microsoft -->
<meta name="msapplication-TileColor" content={themeColor} />

<!-- Structured Data -->
{structuredData && (
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
)}

<!--
  Referrer-Policy: se declara con `name`, NO con `http-equiv`.

  El atributo http-equiv acepta siete valores y ninguno es una cabecera de
  seguridad salvo content-security-policy: content-language, content-type,
  content-security-policy, default-style, refresh, set-cookie y x-ua-compatible.
  MDN lo dice literal en esa misma pagina: "Do not set other security headers
  using <meta http-equiv=, as this can lead to a false sense of security!".

  Aqui vivian ademas X-Content-Type-Options, X-Frame-Options y X-XSS-Protection
  como http-equiv. Los tres eran INERTES: el navegador los ignora, asi que no
  protegian nada y ademas ensuciaban la consola en cada carga. Esas tres van
  como cabecera HTTP real (netlify.toml / public/_headers / .htaccess), que es
  el unico sitio donde surten efecto. X-XSS-Protection no deberia volver ni como
  cabecera: esta retirado de los navegadores y llego a abrir vectores de mXSS.
-->
<meta name="referrer" content="strict-origin-when-cross-origin" />
